# ── Supabase (all environments) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key            # safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server-only — never expose

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Runtime (serverless routes): transaction pooler, port 6543 (prepare=false).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# NOTE: for `drizzle-kit push` / `db:migrate`, point DATABASE_URL at the DIRECT
# connection (port 5432) instead of the pooler.
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Which tables? Production vs Homologation (spec/28) ───────────────────────
# One database, two schemas. `public` = production data; `homolog` = a
# refreshable clone that candidate builds read and write while being validated.
#   Vercel Production env  → public (or leave unset)
#   Vercel Preview env     → homolog
#   Local development      → homolog, strongly recommended: dev and prod share
#                            one database, and this is what keeps your local
#                            experiments off the production tables.
# NEXT_PUBLIC_DB_SCHEMA must always match DB_SCHEMA — the browser bundle uses it
# to namespace Realtime channels, whose names are project-global.
# Refresh the clone with `npm run db:clone:homolog -- --execute`.
DB_SCHEMA=homolog
NEXT_PUBLIC_DB_SCHEMA=homolog

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Realtime channel privacy (defence-in-depth). Unset = public channels (default).
# Set to 1 ONLY after applying spec/migrations/realtime-authorization.sql, which
# makes match channels private + RLS-governed. See src/lib/realtime-client.ts.
# NEXT_PUBLIC_REALTIME_PRIVATE=1

# ── Release console (spec/28, /admin/releases) ───────────────────────────────
# Lets global admins promote and roll back production from the UI. Absent = the
# page renders a setup notice instead of failing.
#   RELEASE_TOKEN     a Vercel API token that may deploy and re-point domains
#   RELEASE_TEAM_ID   Vercel team id
#   HOMOLOG_ALIAS     stable hostname for the homologation deployment
# On Vercel the project and repo ids come from its own system variables; set
# RELEASE_PROJECT_ID / RELEASE_REPO_ID only for local development.
# RELEASE_TOKEN=...
# RELEASE_TEAM_ID=team_...
# RELEASE_PROJECT_ID=prj_...
# RELEASE_REPO_ID=123456789
# HOMOLOG_ALIAS=volleyball-homolog.vercel.app
#
# VERCEL_AUTOMATION_BYPASS_SECRET is injected automatically by Vercel once
# "Protection Bypass for Automation" is enabled on the project — do not set it
# by hand there. Before promoting, the console fetches the candidate's own
# /api/version to learn how many migrations that build expects; deployment URLs
# sit behind Vercel SSO, so without this secret the fetch is refused, promotion
# is blocked as unverifiable, and rollback proceeds with a warning.
# VERCEL_AUTOMATION_BYPASS_SECRET=...   # local development only

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Set both for cross-instance rate limiting via Upstash Redis; unset = per-
# instance in-memory fallback (fine for dev/single-instance).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# ── Billing (optional, future) ───────────────────────────────────────────────
# Stripe webhook is inert (503) until the secret is set. Point a Stripe webhook
# at POST /api/webhooks/stripe with client_reference_id = tenantId.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Set to enable Sentry; unset = no-op. Server uses SENTRY_DSN, client the public.
# SENTRY_DSN=https://...@oXXXX.ingest.sentry.io/XXXX
# NEXT_PUBLIC_SENTRY_DSN=https://...@oXXXX.ingest.sentry.io/XXXX

# ── Seed (optional) ──────────────────────────────────────────────────────────
# Grant the first TENANT_ADMIN to an existing Supabase Auth user.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_USER_ID=<supabase-auth-user-uuid>

# Multi-tenancy (spec/23). Optional: apex domain for tenant subdomains
# (tenant.yourdomain.com). Leave unset for /t/{slug} path routing only.
# Requires the apex + *.wildcard domains to be added to the Vercel project.
NEXT_PUBLIC_ROOT_DOMAIN=

# Transactional email (spec/23 addendum). With SMTP set, invitation/password
# emails use the configurable templates in config/emails/; without it the
# platform falls back to Supabase's built-in mailer (fixed wording, ~2/hour).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Volleyball Scoring <no-reply@example.com>"

# FIVB VIS application id (spec/34 — read-only VIS live scoreboard). Server-only, never NEXT_PUBLIC.
VIS_APP_ID=
